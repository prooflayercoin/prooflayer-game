{
  "name": "@prooflayer/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx src/seed.ts",
    "railway:start": "pnpm db:migrate && pnpm db:seed && pnpm start",
    "seed": "tsx src/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@prooflayer/config": "workspace:*",
    "@prooflayer/shared": "workspace:*",
    "dotenv": "^16.4.5",
    "fastify": "^5.1.0",
    "@fastify/cors": "^10.0.1",
    "pino-pretty": "^11.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
